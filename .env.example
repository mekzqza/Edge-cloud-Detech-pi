# ก๊อปเป็น .env (ไว้ข้าง Run_v2.py / Run_v2_capture.py) แล้วใส่ค่าจริง — .env ห้าม commit
#   cp .env.example .env && chmod 600 .env
# ค่าที่ตั้งใน shell ชนะค่าในไฟล์นี้เสมอ

# backend ที่ Run_v2.py ยิงผลขึ้นไป (URL เต็มรวม /api/detections)
API_URL=
# ไม่บังคับ — ใส่แล้วส่งเป็น header "Authorization: Bearer <คีย์>" (backend ต้องเช็คเองด้วย)
API_KEY=

# รหัส RTSP ของกล้อง (user = admin) แยกต่อกล้อง
CAM_PASSWORD_IN=
CAM_PASSWORD_OUT=

# ไม่บังคับ — จูนต่อกล้องโดยไม่ต้องแก้โค้ด (ไม่ใส่ = ใช้ค่าในตาราง CAMERAS)
# CAM_MOTION_IN=0.05
# CAM_LINGER_IN=15
# CAM_CHANNEL_IN=101
